# Chama production settings. Copy to /opt/chama/.env, chmod 600, fill in every <...>, and keep a copy in a password manager.
# Generate the passwords with `openssl rand -hex 24` and JWT_SECRET with `openssl rand -hex 48`: hex never needs quoting.

CHAMA_ADDRESS=chama.mokicainvestments.co.ke

# PostgreSQL superuser: maintenance and backups only, the application never uses it.
POSTGRES_SUPERUSER_PASSWORD=<openssl rand -hex 24>
# chama_owner: owns chama_db, runs the Flyway migrations, and is the user the API connects as.
# Read by postgres-init/01-owner.sh only when the database is first created: changing it later needs ALTER ROLE as well.
CHAMA_DB_PASSWORD=<openssl rand -hex 24>

# HS256 signing key, at least 32 bytes. The prod profile refuses to start without it.
JWT_SECRET=<openssl rand -hex 48>

# First platform administrator, created once at start-up. Password: 8-72 characters, a letter and a digit.
# Delete both lines after the first sign-in and password change.
PLATFORM_ADMIN_EMAIL=<you@mokicainvestments.co.ke>
PLATFORM_ADMIN_PASSWORD=<strong password>

MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM="Chama <no-reply@mokicainvestments.co.ke>"
# false = leave mail out of /actuator/health until a real mail server is set above (emails will still fail, unseen).
MAIL_HEALTH_CHECK=true

# Built into the frontend: rebuild chama-web after changing them.
SUPPORT_EMAIL=
SUPPORT_PHONE=
IDLE_TIMEOUT_MINUTES=15

# Backups (backup.sh). BACKUP_REMOTE: an rclone remote, e.g. b2:<bucket>/chama. Empty = this server only.
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=60
